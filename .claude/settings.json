{
  "enabledMcpjsonServers": [
    "atlassian"
  ],
  "permissions": {
    "allow": [
      "Bash(pwsh * .github/skills/git-branch-creator/scripts/create-branch.ps1*)",
      "Bash(pwsh * .github/skills/git-commit-creator/scripts/create-commit.ps1*)",
      "Bash(pwsh * .github/skills/git-pr-creator/scripts/create-pr.ps1*)",
      "Bash(pwsh * .github/skills/git-push-creator/scripts/push-branch.ps1*)",
      "Bash(pwsh * .github/skills/git-workflow-orchestrator/scripts/run-git-ship-workflow.ps1*)",
      "Bash(node .claude/skills/exploratory-testing/scripts/pw.mjs*)",
      "mcp__atlassian__*"
    ],
    "deny": [
      "Read(.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-metrics.mjs\" --pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command \"$d = $input | ConvertFrom-Json; $p = $d.tool_input.file_path; if ($p -match '\\.github[\\\\/]skills[\\\\/]') { Write-Output 'MIRROR REMINDER: sync changes to .claude/skills/ and .cursor/skills/' }\""
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command \"$d = $input | ConvertFrom-Json; $p = $d.tool_input.file_path; if ($p -match '\\.py$') { if (Get-Command ruff -ErrorAction SilentlyContinue) { ruff check $p } else { Write-Output 'ruff not found - skipping lint (install: pip install ruff)' } }\""
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-metrics.mjs\" --post"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-metrics.mjs\" --failed"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true
  }
}
